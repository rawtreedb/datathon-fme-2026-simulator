# Copy to .env. KEY=VALUE only (systemd reads it too); load it with `set -a; . ./.env; set +a`.
# Admin key of your RawTree cluster (admin.py creates databases, tables, roles and keys)
RAWTREE_API_KEY=rt_...
# Seeds used at the event: catalogue/shoppers/history, practice stream, final stream (same seeds = same world)
WORLD_SEED=329180804
SEED_A=805223772
SEED_B=2062992712
# Times (UTC). At the event: history until Sat 08:00 CET, practice Sat 10:00, final Sun 10:00-12:00 CET.
HISTORY_END=2026-11-14T07:00:00Z
PRACTICE_START=2026-11-14T09:00:00Z
FINAL_START=2026-11-15T09:00:00Z
FINAL_END=2026-11-15T11:00:00Z
# Answer deadline (s), requests per second, organic events per second
DEADLINE_S=3
RATE=3
EVENTS_RATE=50
